{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "database.rules.json",
      "storage.rules",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "docs/**",
      "scripts/**",
      "README.md",
      ".vapid_private.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/frontend/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "bucket": "avenora-6e147.firebasestorage.app"
  }
}
