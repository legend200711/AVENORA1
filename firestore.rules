rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Posts ──────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.author.id == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.author.id == request.auth.uid
              || isModeratorOrAbove());
      }
    }

    // ── Users / Profiles ───────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      // Users can only write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Gallery ────────────────────────────────────────────
    match /gallery/{itemId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.author.id == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
      allow update: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
    }

    // ── User Preferences ───────────────────────────────────
    // Private — each user can only read and write their own preferences.
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Stories ────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.author.id == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
    }

    // ── Founder Themes ─────────────────────────────────────
    // No ordinary user or moderator may read, write, or list founder themes.
    // Theme tokens are served from the backend API (/api/themes/active)
    // which applies its own validation — no direct Firestore access needed.
    match /founderThemes/{themeId} {
      allow read, write: if false; // managed exclusively by the backend
    }

    // ── Helper functions ───────────────────────────────────
    function isModeratorOrAbove() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           in ['moderator', 'admin', 'founder'];
    }

    function isFounderOrAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           in ['admin', 'founder'];
    }
  }
}
