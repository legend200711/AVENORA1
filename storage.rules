rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Avatars ────────────────────────────────────────────
    // Users can only write their own avatar; everyone can read
    match /avatars/{userId}.{ext} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // ── Images (posts, gallery) ────────────────────────────
    match /images/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 20 * 1024 * 1024; // 20 MB
    }

    // ── Audio (music uploads) ──────────────────────────────
    match /audio/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size < 100 * 1024 * 1024; // 100 MB
    }

    // ── Videos ────────────────────────────────────────────
    match /videos/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024 * 1024; // 500 MB
    }
  }
}
